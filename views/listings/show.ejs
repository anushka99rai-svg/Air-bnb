<% layout("/layouts/boilerplate") -%>
<div class="row mt-3">
<div class="col-8 offset-2">
  <h3><%=listing.title %></h3>
  <div class="listing-card mt-3">
  <img src="<%=listing.image %>" class="card-img-top list-img" alt="Listing image">
  <div class="card-body">
    <p class="card-text">
       <%= listing.description %><br>
        &#8377;<%= listing.price != null ? listing.price.toLocaleString("en-IN") : "N/A" %><br>
        <%= listing.location %><br>
        <%= listing.country %>
    </p>
  </div>
  </div>
</div>
</div> 
<div class="row">
    <div class="col-8 offset-2">
           <div class="btns d-flex gap-3 mb-4">
               <a href="/listings/<%=listing.id %>/edit" class="btn btn-dark edit-btn">Edit Listing</a>
               <form action="/listings/<%=listing.id %>?_method=DELETE" method="POST">
                <button type="submit" class="btn btn-dark edit-btn">Delete</button>
               </form>
           </div>
           <hr>
           <form action="/listings/<%=listing.id %>/reviews" method="POST" novalidate data-bs-validate>
              <h4>Add some reviews</h4>
              <br>
              <div>
              <label for="rating">Rating</label>
              <input id="rating" type="range" min="1" max="5" name="review[rating]">
              </div>
              <div>
              <label for="comment" class="form-label">Comment</label>
              <textarea id="comment" name="review[comment]" class="form-control" placeholder="Enter your views" required></textarea>
              <div class="invalid-feedback">Please add a comment !</div>
              </div>
              <button type="submit">Submit</button>
           </form>
           <hr>
           <h4>All Reviews</h4>
           <div class="row">
            <% for (review of listing.reviews) { %>
              <div class="card col-5 mb-3 ms-3">
                <div class="card-body">
                  <h5 class="card-title">John Doe</h5>
                  <p class="card-text"><%= review.rating %> stars</p>
                  <p class="card-text"><%= review.comment %></p>
              </div>
              <form action="/listings/<%=listing.id %>/reviews/<%=review.id %>?_method=DELETE" method="POST">
                <button type="submit" class="btn-sm btn-dark mb-2">Delete</button>
              </form>
              </div>
            <% } %>
           </div>
    </div>
</div>
