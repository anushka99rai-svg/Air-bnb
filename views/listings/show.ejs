<% layout("/layouts/boilerplate") -%>
<div class="row mt-3">
<div class="col-8 offset-2">
  <h3><%=listing.title %></h3>
  <div class="listing-card mt-3">
  <img src="<%=listing.image %>" class="card-img-top list-img" alt="Listing image">
  <div class="card-body">
    <p class="card-text">
       <%= listing.description %><br>
        &#8377;<%= listing.price != null ? listing.price.toLocaleString("en-IN") : "N/A" %><br>
        <%= listing.location %><br>
        <%= listing.country %>
    </p>
  </div>
  </div>
</div>
</div> 
<div class="row">
    <div class="col-8 offset-2">
           <div class="btns d-flex gap-3 mb-4">
               <a href="/listings/<%=listing.id %>/edit" class="btn btn-dark edit-btn">Edit Listing</a>
               <form action="/listings/<%=listing.id %>?_method=DELETE" method="POST">
                <button type="submit" class="btn btn-dark edit-btn">Delete</button>
               </form>
           </div>
    </div>
</div>
