<% layout("/layouts/boilerplate") -%>
    <div class="row">
        <div class="col-8 offset-2">
    <form action="/listings" method="POST" data-bs-validate novalidate>
         <br><br>
    <h3>Create a new Listing</h3>

    <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input name="title" type="text" required class="form-control" placeholder="Add a catchy title" id="title" required>
        <div class="valid-feedback">Looks! Great</div>
        <div class="invalid-feedback">Please Enter a title</div>
    </div>

    <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea name="description" id="description" class="form-control" required></textarea>
        <div class="invalid-feedback">Please Enter a nice description</div>
    </div>

    <div class="mb-3">
        <label for="image" class="form-label">Image</label>
        <input name="image"  type="text" class="form-control" id="image" required>
        <div class="invalid-feedback">Image Required</div>
    </div>

    <div class="row">

         <div class="mb-3 md:col-4">
        <label for="price" class="form-label">Price</label>
        <input name="price" type="number" id="price" placeholder= "1200" class="form-control" required>
        <div class="invalid-feedback">Enter a valid price</div>
    </div>
      
       <div class="mb-3 md:col-8">
         <label for="location" class="form-label">Location</label>
         <input name="location" type="text" id="location" class="form-control" placeholder="Jaipur,Rajasthan" required>
         <div class="invalid-feedback">Enter a valid Location</div>
       </div>
    </div>

    <div class="mb-3">
        <label for="country" class="form-label">Country</label>
         <input name="country" type="text" id="country" class="form-control" placeholder="India" required>
         <div class="invalid-feedback">Enter a valid country name</div>
    </div>

    <div class="mb-3">
        <button class="btn btn-dark " type="submit">Add</button>
    </div>

    <br><br>
    </form>
</div>
</div>
